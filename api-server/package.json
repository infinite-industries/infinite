{
  "name": "infinite-api",
  "version": "0.0.1",
  "description": "database and for art work/event management and presentation",
  "author": {
    "name": "Infinite Crew",
    "url": "https://infinite.industries/who-we-are"
  },
  "private": true,
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "postbuild": "npm run copy-constants",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "sequelize-cli db:migrate && nest start",
    "start:dev": "sequelize-cli db:migrate && npm run copy-constants && nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "copy-constants": "copyfiles -u src/db_constants.js dist/",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --experimental-vm-modules --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "node ./test/clearLogFile.js && nest build && node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest-e2e.json --runInBand",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:down-one": "sequelize-cli db:migrate:undo",
    "db:migrate:generate": "sequelize-cli migration:generate",
    "db:seed": "sequelize db:seed:all",
    "db:seed:venues": "sequelize db:seed --seed 20190929142748-venues.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.418.0",
    "@nestjs/common": "^12.5.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/sequelize": "^12.0.1",
    "@nestjs/serve-static": "^12.1.1",
    "@nestjs/swagger": "^12.1.2",
    "@types/jsonwebtoken": "^9.0.2",
    "axios": "^1.21.1",
    "class-transformer": "^0.5.1",
    "dotenv": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "moment": "~2.29.1",
    "moment-timezone": "~0.5.33",
    "nest-winston": "^2.0.0",
    "pg": "^8.3.2",
    "pg-hstore": "^2.3.3",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rxjs": "^7.2.0",
    "sequelize": "^6.32.1",
    "sequelize-cli": "^6.6.1",
    "sequelize-typescript": "^2.1.5",
    "slack-notify": "^2.0.6",
    "uuid": "^8.3.0",
    "winston": "^3.3.3"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.25.1",
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.5.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.13",
    "@types/node": "^26.6.6",
    "@types/node-geocoder": "^4.2.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "class-validator": "^0.15.1",
    "copyfiles": "^2.4.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.20.1",
    "eslint-plugin-prettier": "^5.5.7",
    "faker": "^5.5.3",
    "frisby": "^2.1.3",
    "jest": "^30.5.2",
    "node-geocoder": "^4.2.0",
    "prettier": "^3.6.2",
    "sharp": "^0.32.6",
    "source-map-support": "^0.5.20",
    "supertest": "^7.3.2",
    "testcontainers": "^10.2.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "4.2.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "diagnostics": {
            "ignoreCodes": [
              151002
            ]
          }
        }
      ]
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
